infra/mosquitto/data/*
!infra/mosquitto/data/.gitkeep

# Generated by infra/mosquitto/setup/generate.sh (Sprint 11) - a self-signed
# dev CA/server cert and the MQTT password file, never committed even
# though these are local-dev-only secrets.
infra/mosquitto/certs/*
!infra/mosquitto/certs/.gitkeep
infra/mosquitto/config/passwd

# Docker volumes (bind-mounted local data, not source)
infra/postgres-data/
