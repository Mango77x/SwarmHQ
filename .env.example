# Copy this file to .env before running docker compose up.
# .env is gitignored - never commit real credentials, even dev ones.

POSTGRES_DB=swarmhq
POSTGRES_USER=swarmhq
POSTGRES_PASSWORD=changeme

# 5433, not 5432: avoids clashing with a native/already-installed PostgreSQL
# that may already be bound to 5432 on the host machine.
POSTGRES_PORT=5433

MQTT_PORT=1883
MQTT_WS_PORT=9001
