# Copy this file to .env before running docker compose up.
# .env is gitignored - never commit real credentials, even dev ones.

POSTGRES_DB=swarmhq
POSTGRES_USER=swarmhq
POSTGRES_PASSWORD=changeme

# 5433, not 5432: avoids clashing with a native/already-installed PostgreSQL
# that may already be bound to 5432 on the host machine.
POSTGRES_PORT=5433

MQTT_PORT=8883
MQTT_WS_PORT=9001

# MQTT credentials (Sprint 11) - password_file entries generated by
# infra/mosquitto/setup/generate.sh on first `docker compose up`. All
# simulated drones share one password (they're the same trust tier, a
# fleet of field units) but each still gets its own username (drone-1,
# drone-2, ...) - the ACL file scopes each one to only its own topics
# regardless of the shared password.
MQTT_BACKEND_PASSWORD=changeme
MQTT_DRONE_PASSWORD=changeme

# Sprint 14: "centralized" (default, Sprint 10's greedy engine) or
# "auction" (drones bid on missions/available). Sprint 16 made this the
# *initial* value only - switch it live afterward via the frontend toggle
# or PUT /api/mode instead of restarting (see HELP.md).
MISSION_ASSIGNMENT_MODE=centralized
